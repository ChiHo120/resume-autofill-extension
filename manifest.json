{
  "manifest_version": 3,
  "name": "简历智能填充",
  "version": "0.5.1",
  "key": "",
  "minimum_chrome_version": "116",
  "description": "扫描表单，使用可配置 AI 生成填写计划，经确认后填充。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "简历智能填充"
  }
}
